# ──────────────────────────────────────────────────────────────────────────────
# Resume Ranking System — example environment file (Part 7.9)
# Copy to `.env` and fill in real values.  The app reads these via os.environ.
# Never commit a real `.env` to version control.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=resume_ranking
PG_USER=postgres
PG_PASSWORD=change-me

# Ollama LLM server
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b-q4_K_M

# Paths
RESUMES_BASE=./downloaded_resumes
RANKER_PATH=./ranker.py
# Leave VENV_PYTHON blank to use the current interpreter
# VENV_PYTHON=

# Concurrency
RANKER_WORKERS=5

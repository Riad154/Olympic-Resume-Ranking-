# =============================================================================
# Streamlit Cloud Secrets — Full Cloud Deployment Configuration
# =============================================================================
# Copy this to .streamlit/secrets.toml (DO NOT commit the real file!)
# Add these in Streamlit Cloud: App → Settings → Secrets
#
# For LOCAL development, use a .env file in the project root instead.
#
# Deployment architecture:
#   Streamlit Cloud (UI)  ←──→  Neon PostgreSQL (DB)
#                        ←──→  VPS: Ollama (LLM)  — via OLLAMA_HOST
#                        ←──→  VPS: n8n (Workflow) — via N8N_HOST
# =============================================================================

# ── PostgreSQL (Neon — free serverless Postgres) ────────────────────────────
# Sign up: https://neon.tech → Create project → Copy connection string
[postgresql]
host = "your-project.neon.tech"
port = "5432"
dbname = "neondb"
user = "neondb_owner"
password = "your-neon-password"

# ── Remote Ollama (on your VPS) ─────────────────────────────────────────────
# Direct VPS IP (no auth — firewall restrict to Streamlit Cloud only):
#   OLLAMA_HOST = "http://YOUR_VPS_IP:11434"
# Via nginx reverse proxy with basic auth:
#   OLLAMA_HOST = "https://admin:your-password@your-domain.com/ollama"
OLLAMA_HOST = ""
OLLAMA_MODEL = "qwen3:8b-q4_K_M"

# ── Remote n8n (on your VPS) ────────────────────────────────────────────────
# Direct VPS IP:
#   N8N_HOST = "http://YOUR_VPS_IP:5678"
# Via nginx reverse proxy with basic auth:
#   N8N_HOST = "https://admin:your-password@your-domain.com/n8n"
N8N_HOST = ""

# ── GitHub Actions trigger (for BDJobs CV sync) ─────────────────────────────
[github]
token = "ghp_xxxxxxxxxxxxxxxxxxxx"  # Personal Access Token with 'repo' + 'workflow' scopes
repo = "Riad154/Olympic-Resume-Ranking-"

# ── BDJobs credentials (used by GitHub Actions runner) ──────────────────────
[bdjobs]
username = "your_bdjobs_username"
password = "your_bdjobs_password"

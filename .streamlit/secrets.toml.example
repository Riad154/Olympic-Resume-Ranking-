# =============================================================================
# Streamlit Cloud Secrets — Full Cloud Deployment Configuration
# =============================================================================
# Copy this to .streamlit/secrets.toml (DO NOT commit the real file!)
# Add these in Streamlit Cloud: App → Settings → Secrets
#
# IMPORTANT TOML RULE: Keys placed after a [section] header belong to that
# section. Always put OLLAMA_HOST and N8N_HOST inside [services] section.
# =============================================================================

# ── Remote services (Ollama + n8n via ngrok tunnel) ─────────────────────────
# Get your ngrok URLs from: http://127.0.0.1:4040 after running start-tunnels.bat
[services]
OLLAMA_HOST = "https://your-tunnel.ngrok-free.app"
OLLAMA_MODEL = "qwen3:8b-q4_K_M"
N8N_HOST = "https://your-n8n-tunnel.ngrok-free.app"

# ── PostgreSQL (Neon — free serverless Postgres) ────────────────────────────
# Sign up: https://neon.tech → Create project → Copy connection string
[postgresql]
host = "your-project.neon.tech"
port = "5432"
dbname = "neondb"
user = "neondb_owner"
password = "your-neon-password"

# ── GitHub Actions trigger (for BDJobs CV sync) ─────────────────────────────
[github]
token = "ghp_xxxxxxxxxxxxxxxxxxxx"
repo = "Riad154/Olympic-Resume-Ranking-"

# ── BDJobs credentials (used by GitHub Actions runner) ──────────────────────
[bdjobs]
username = "your_bdjobs_username"
password = "your_bdjobs_password"
